# swarm .env.example — every credential swarm consumes.
#
# Usage:
#   cp .env.example .env
#   # Fill in the values you need (leave unused sinks blank).
#   bash scripts/bootstrap.sh --env-file .env
#
# Rule: behavior is committed (swarm.config.yml), secrets never are.
# This file documents names only — no values are ever stored here.
# .env is gitignored and is a local provisioning input only.
# Rotate a key: edit .env, re-run bootstrap.sh.
#
# See SPEC §2.6 for the configuration model.
# ─────────────────────────────────────────────────────────────────────────────

# ── GitHub ────────────────────────────────────────────────────────────────────

# Fine-grained PAT for swarm workflows that need cross-repo or Projects scope
# (e.g. creating labels, environments, secrets in the consumer repo).
# Create at: https://github.com/settings/tokens → Fine-grained tokens
# Required permissions on the consumer repo:
#   Actions: read/write, Issues: read/write, Pull requests: read/write,
#   Contents: read/write, Secrets: write, Environments: write
# Sink/adapter: all GitHub API calls made by bootstrap.sh at setup time.
SWARM_GITHUB_TOKEN=

# Reviewer PAT — used by the swarm pipeline to request the human approval gate.
# Introduced in #8. Create a fine-grained PAT for the designated reviewer account.
# Required permissions: issues: write, pull_requests: read on the consumer repo.
# Sink/adapter: intake.yml approval step; swarm-approval environment gate.
SWARM_TOKEN=

# ── Notification sinks ────────────────────────────────────────────────────────

# Slack incoming webhook URL for the Slack notify adapter (webhook mode).
# Create at: https://api.slack.com/apps → Your App → Incoming Webhooks → Add New
# Webhook mode and bot-token mode are mutually exclusive; webhook wins when both set.
# Sink/adapter: actions/notify/adapters/slack.sh
SWARM_SLACK_WEBHOOK=

# Slack bot token for the Slack notify adapter (bot-token mode).
# Create at: https://api.slack.com/apps → Your App → OAuth & Permissions
# Required scope: chat:write. Pair with notify.slack_channel in swarm.config.yml.
# Bot-token mode posts as the bot's identity. Webhook wins when both configured.
# Sink/adapter: actions/notify/adapters/slack.sh
SWARM_SLACK_BOT_TOKEN=

# Discord incoming webhook URL for the Discord notify adapter (webhook mode).
# Create in Discord: Channel Settings → Integrations → Webhooks → New Webhook
# Webhook mode and bot-token mode are mutually exclusive; webhook wins when both set.
# Sink/adapter: actions/notify/adapters/discord.sh
SWARM_DISCORD_WEBHOOK=

# Discord bot token for the Discord notify adapter (bot-token mode).
# Create at: https://discord.com/developers/applications → Your App → Bot → Token
# Pair with notify.discord_channel in swarm.config.yml (the channel ID).
# Bot-token mode posts as the bot's identity. Webhook wins when both configured.
# Sink/adapter: actions/notify/adapters/discord.sh
SWARM_DISCORD_BOT_TOKEN=

# Microsoft Teams incoming webhook URL for the Teams notify adapter.
# Create in Teams: Channel → (⋯) → Connectors → Incoming Webhook → Configure
# Sink/adapter: actions/notify/adapters/teams.sh
SWARM_TEAMS_WEBHOOK=

# Buzz / Nostr relay WebSocket URL (NIP-29).
# NOT a webhook — buzz uses a Nostr relay + NIP-42 authenticated signed events.
# The channel UUID (behavior) belongs in swarm.config.yml as notify.buzz_channel.
# Example: wss://relay.example.com
# See SPEC §2.3 and actions/notify/adapters/buzz.sh.
SWARM_BUZZ_RELAY_URL=

# Buzz / Nostr bot private key (hex or nsec format).
# The buzz adapter uses this key to sign kind:9 events tagged with the channel UUID.
# Generate with: nak key generate
# Sink/adapter: actions/notify/adapters/buzz.sh
SWARM_BUZZ_PRIVATE_KEY=

# ── LLM credentials ───────────────────────────────────────────────────────────

# Anthropic API key — used by the claude adapter (agent-run and develop-run).
# Create at: https://console.anthropic.com/settings/keys
# Sink/adapter: actions/agent-run/adapters/claude.sh
# See also: CLAUDE_CODE_OAUTH_TOKEN (alternative for Max/Pro subscribers)
ANTHROPIC_API_KEY=

# Alternative to ANTHROPIC_API_KEY for Max/Pro plan subscribers.
# Mint with: claude setup-token (requires an active Claude Max or Pro subscription).
# The Claude CLI and claude-code-action both honour this env var.
# Only one of ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN is required.
# Sink/adapter: actions/agent-run/adapters/claude.sh
CLAUDE_CODE_OAUTH_TOKEN=

# Generic LLM API key — used by the openai-compat adapter when the endpoint
# requires authentication (Ollama, LM Studio, vLLM, or any hosted provider).
# Leave blank if your local endpoint requires no authentication.
# Sink/adapter: actions/agent-run/adapters/openai-compat.sh
SWARM_LLM_API_KEY=

# ── Reserved (v2 — not yet implemented) ──────────────────────────────────────

# GitLab PAT — reserved for the GitLab CI variables provisioning port (v2).
# Do not use; provisioning logic is not yet implemented.
SWARM_GITLAB_TOKEN=

# Azure DevOps PAT — reserved for the ADO variable groups provisioning port (v2).
# Do not use; provisioning logic is not yet implemented.
SWARM_AZURE_TOKEN=
