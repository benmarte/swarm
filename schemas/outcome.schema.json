{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "swarm/outcome@1",
  "title": "Swarm Outcome",
  "description": "Schema-validated agent output for the swarm pipeline. Per SPEC §2.4.",
  "type": "object",
  "required": ["schema", "role", "verdict", "refs", "evidence"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "swarm/outcome@1"
    },
    "role": {
      "type": "string",
      "enum": ["validator", "pm", "reviewer", "security", "docs", "orchestrator"]
    },
    "verdict": {
      "type": "string"
    },
    "refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issue": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "pr": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true
    },
    "notes": {
      "type": "string"
    }
  },
  "if": {
    "properties": { "role": { "const": "validator" } },
    "required": ["role"]
  },
  "then": {
    "properties": {
      "verdict": { "enum": ["confirmed", "duplicate", "invalid", "needs-info"] },
      "refs": {
        "type": "object",
        "required": ["issue"],
        "properties": { "issue": { "type": "integer", "minimum": 1 } }
      }
    }
  },
  "else": {
    "if": {
      "properties": { "role": { "const": "pm" } },
      "required": ["role"]
    },
    "then": {
      "properties": {
        "verdict": { "enum": ["spec", "escalated"] },
        "refs": {
          "type": "object",
          "required": ["issue"],
          "properties": { "issue": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "else": {
      "if": {
        "properties": { "role": { "const": "reviewer" } },
        "required": ["role"]
      },
      "then": {
        "properties": {
          "verdict": { "enum": ["approve", "request-changes"] },
          "refs": {
            "type": "object",
            "required": ["issue"],
            "properties": { "issue": { "type": "integer", "minimum": 1 } }
          }
        }
      },
      "else": {
        "if": {
          "properties": { "role": { "const": "security" } },
          "required": ["role"]
        },
        "then": {
          "properties": {
            "verdict": { "enum": ["pass", "fail", "advisory"] },
            "refs": {
              "type": "object",
              "required": ["issue"],
              "properties": { "issue": { "type": "integer", "minimum": 1 } }
            }
          }
        },
        "else": {
          "if": {
            "properties": { "role": { "const": "docs" } },
            "required": ["role"]
          },
          "then": {
            "properties": {
              "verdict": { "enum": ["done", "skipped"] },
              "refs": {
                "type": "object",
                "required": ["issue"],
                "properties": { "issue": { "type": "integer", "minimum": 1 } }
              }
            }
          },
          "else": {
            "if": {
              "properties": { "role": { "const": "orchestrator" } },
              "required": ["role"]
            },
            "then": {
              "properties": {
                "verdict": { "enum": ["report"] },
                "refs": {
                  "type": "object",
                  "properties": { "issue": { "type": ["integer", "null"] } }
                }
              }
            }
          }
        }
      }
    }
  }
}
