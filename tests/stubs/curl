#!/usr/bin/env bash
# Stub curl for bats tests.
# Records every invocation (with arguments) to $CURL_STUB_LOG.
# Records the request body (-d / --data) to $CURL_BODY_LOG (one payload per line, JSON).
# Records -H headers (names only, never values) to $CURL_HEADER_LOG.
# Returns CURL_STUB_STATUS exit code (default 0).
# If CURL_STUB_RESPONSE is set, prints it; otherwise silent.
#
# Secret hygiene: header values are intentionally NOT logged. Tests must only
# assert on header name presence (e.g. "Authorization") — never on the value.

LOG="${CURL_STUB_LOG:-/tmp/curl-stub.log}"
BODY_LOG="${CURL_BODY_LOG:-/tmp/curl-body.log}"
HEADER_LOG="${CURL_HEADER_LOG:-/tmp/curl-header.log}"

# Record full argv
echo "curl $*" >> "$LOG"

# Parse argv to extract -d body and -H header names
args=("$@")
body=""
i=0
while [ $i -lt ${#args[@]} ]; do
  arg="${args[$i]}"
  case "$arg" in
    -d|--data)
      i=$((i+1))
      body="${args[$i]:-}"
      ;;
    -d*)
      body="${arg#-d}"
      ;;
    -H|--header)
      i=$((i+1))
      # Log only the header name (before the colon), not the value
      header_name="${args[$i]%%:*}"
      echo "$header_name" >> "$HEADER_LOG"
      ;;
    -H*)
      header_val="${arg#-H}"
      header_name="${header_val%%:*}"
      echo "$header_name" >> "$HEADER_LOG"
      ;;
  esac
  i=$((i+1))
done

if [ -n "$body" ]; then
  echo "$body" >> "$BODY_LOG"
fi

if [ -n "${CURL_STUB_RESPONSE:-}" ]; then
  echo "$CURL_STUB_RESPONSE"
fi

exit "${CURL_STUB_STATUS:-0}"
