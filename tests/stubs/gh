#!/usr/bin/env bash
# Stub gh CLI for bats tests.
# Records every invocation (with arguments) to $GH_STUB_LOG.
# Responds with configurable fixture data via GH_STUB_* env vars.
set -euo pipefail

LOG="${GH_STUB_LOG:-/tmp/gh-stub.log}"
# Summary line: single-line record with safe TOKEN_SOURCE marker (no body expansion).
# Uses "gh-summary" prefix so existing grep -c "^gh api" counts stay correct.
# _GH_TOKEN_SOURCE is set to "swarm" or "default" by the engine's env-prefix.
printf 'gh-summary %s%s TOKEN_SOURCE=%s\n' "${1:-}" "${2:+ $2}" "${_GH_TOKEN_SOURCE:-default}" >> "$LOG"
# Full invocation line (may be multi-line when --body contains newlines).
echo "gh $*" >> "$LOG"

# ── gh pr create ─────────────────────────────────────────────────────────────
if [ "${1:-}" = "pr" ] && [ "${2:-}" = "create" ]; then
  # Record the full invocation (already done above via LOG)
  # Capture --body / --body-file for PR body log
  pr_body_log="${GH_PR_BODY_LOG:-}"
  i=3
  args=("$@")
  while [ $i -lt ${#args[@]} ]; do
    arg="${args[$i]}"
    case "$arg" in
      --body)
        i=$((i+1))
        if [ -n "$pr_body_log" ]; then
          printf '%s' "${args[$i]}" > "$pr_body_log"
        fi
        ;;
      --body-file)
        i=$((i+1))
        if [ -n "$pr_body_log" ] && [ -f "${args[$i]}" ]; then
          cat "${args[$i]}" > "$pr_body_log"
        fi
        ;;
    esac
    i=$((i+1))
  done
  # Return the configured PR URL (defaults to a plausible stub URL)
  printf '%s\n' "${GH_PR_URL_STUB:-https://github.com/testowner/testrepo/pull/42}"
  exit 0
fi

# ── gh issue edit ─────────────────────────────────────────────────────────────
if [ "${1:-}" = "issue" ] && [ "${2:-}" = "edit" ]; then
  # log only, succeed
  exit 0
fi

# ── gh issue comment ──────────────────────────────────────────────────────────
if [ "${1:-}" = "issue" ] && [ "${2:-}" = "comment" ]; then
  exit 0
fi

# ── gh issue close ────────────────────────────────────────────────────────────
if [ "${1:-}" = "issue" ] && [ "${2:-}" = "close" ]; then
  exit 0
fi

# ── gh issue view ────────────────────────────────────────────────────────────
if [ "${1:-}" = "issue" ] && [ "${2:-}" = "view" ]; then
  printf '%s\n' "${GH_STUB_ISSUE_JSON:-{\"number\":1,\"title\":\"test\",\"body\":\"\",\"labels\":[],\"comments\":[]}}"
  exit 0
fi

# ── gh pr view ───────────────────────────────────────────────────────────────
if [ "${1:-}" = "pr" ] && [ "${2:-}" = "view" ]; then
  printf '%s\n' "${GH_PR_URL_STUB:-https://github.com/testowner/testrepo/pull/42}"
  exit 0
fi

# ── gh api ───────────────────────────────────────────────────────────────────
if [ "${1:-}" = "api" ]; then
  method="GET"
  path=""
  jq_expr=""
  fields=()
  input_file=""
  args=("$@")
  i=1
  while [ $i -lt ${#args[@]} ]; do
    arg="${args[$i]}"
    case "$arg" in
      --method|-X)
        i=$((i+1))
        method="${args[$i]}"
        ;;
      --jq)
        i=$((i+1))
        jq_expr="${args[$i]}"
        ;;
      --field|-f)
        i=$((i+1))
        fields+=("${args[$i]}")
        ;;
      --raw-field)
        i=$((i+1))
        fields+=("${args[$i]}")
        ;;
      --input)
        i=$((i+1))
        input_file="${args[$i]}"
        ;;
      -*)
        # skip unknown flag; next arg is its value if it's not another flag
        next_i=$((i+1))
        if [ $next_i -lt ${#args[@]} ] && ! printf '%s' "${args[$next_i]}" | grep -q '^-'; then
          i=$next_i
        fi
        ;;
      *)
        if [ -z "$path" ]; then
          path="$arg"
        fi
        ;;
    esac
    i=$((i+1))
  done

  # GET /repos/.../issues/<N> (single issue — for anchor state reads)
  if [ "$method" = "GET" ] && printf '%s' "$path" | grep -qE '/issues/[0-9]+$'; then
    # GH_STUB_ISSUE_GET_FAIL=1 simulates a transient API failure (rate-limit, network)
    if [ -n "${GH_STUB_ISSUE_GET_FAIL:-}" ]; then
      printf '{"message":"API rate limit exceeded"}\n' >&2
      exit 1
    fi
    _default_issue_json='{"number":1,"title":"test","body":"","labels":[],"comments":[]}'
    issue_json="${GH_STUB_ISSUE_JSON:-$_default_issue_json}"
    if [ -n "$jq_expr" ]; then
      printf '%s' "$issue_json" | jq -r "$jq_expr"
    else
      printf '%s\n' "$issue_json"
    fi
    exit 0
  fi

  # PATCH /repos/.../issues/<N> (anchor state write)
  if [ "$method" = "PATCH" ] && printf '%s' "$path" | grep -qE '/issues/[0-9]+$'; then
    # Log body content for test assertions
    if [ -n "${GH_STUB_ISSUE_BODY_LOG:-}" ]; then
      if [ -n "$input_file" ] && [ "$input_file" != "-" ] && [ -f "$input_file" ]; then
        cat "$input_file" > "$GH_STUB_ISSUE_BODY_LOG"
      elif [ -n "$input_file" ] && [ "$input_file" = "-" ]; then
        cat > "$GH_STUB_ISSUE_BODY_LOG"
      fi
    fi
    exit 0
  fi

  # GET /repos/.../pulls (PR verification) → return stub PR array
  if [ "$method" = "GET" ] && printf '%s' "$path" | grep -q '/pulls$'; then
    pr_json="${GH_STUB_PR_JSON:-}"
    if [ -z "$pr_json" ]; then
      # Build a minimal PR object from GH_PR_URL_STUB
      pr_url="${GH_PR_URL_STUB:-https://github.com/testowner/testrepo/pull/42}"
      pr_json="[{\"html_url\":\"$pr_url\",\"number\":42,\"state\":\"open\",\"head\":{\"ref\":\"swarm/issue-1\"}}]"
    fi
    if [ -n "$jq_expr" ]; then
      printf '%s' "$pr_json" | jq -r "$jq_expr"
    else
      printf '%s\n' "$pr_json"
    fi
    exit 0
  fi

  # GET /repos/.../issues/.../labels → return fixture labels
  if [ "$method" = "GET" ] && printf '%s' "$path" | grep -q '/labels$'; then
    labels_json="${GH_STUB_LABELS_JSON:-[]}"
    if [ -n "$jq_expr" ]; then
      printf '%s' "$labels_json" | jq -r "$jq_expr"
    else
      printf '%s\n' "$labels_json"
    fi
    exit 0
  fi

  # DELETE label → log only, succeed
  if [ "$method" = "DELETE" ]; then
    exit 0
  fi

  # POST labels → log only, succeed
  if [ "$method" = "POST" ] && printf '%s' "$path" | grep -q '/labels$'; then
    exit 0
  fi

  # POST assignees → log only, succeed
  if [ "$method" = "POST" ] && printf '%s' "$path" | grep -q '/assignees$'; then
    exit 0
  fi

  # POST comments → log only, succeed
  if [ "$method" = "POST" ] && printf '%s' "$path" | grep -q '/comments$'; then
    exit 0
  fi

  # GET /users/<login> → return stub user object
  if [ "$method" = "GET" ] && printf '%s' "$path" | grep -qE '^users/[^/]+$'; then
    user_id="${GH_STUB_USER_ID:-99999}"
    if [ -n "$jq_expr" ]; then
      printf '{"id":%s,"login":"stubuser"}' "$user_id" | jq -r "$jq_expr"
    else
      printf '{"id":%s,"login":"stubuser"}\n' "$user_id"
    fi
    exit 0
  fi

  # GET /repos/.../labels/<name> → return label if it "exists" via GH_STUB_EXISTING_LABELS
  if [ "$method" = "GET" ] && printf '%s' "$path" | grep -qE '/labels/'; then
    label_name="$(printf '%s' "$path" | sed 's|.*/labels/||')"
    existing="${GH_STUB_EXISTING_LABELS:-}"
    if printf '%s' "$existing" | grep -qF "$label_name"; then
      printf '{"name":"%s"}\n' "$label_name"
    else
      # Real gh api prints a JSON error body to stdout on 404 then exits 1.
      # Emulate that exactly so exit-code-vs-stdout checks regress loudly here.
      printf '{"message":"Not Found","documentation_url":"https://docs.github.com/rest","status":"404"}\n'
      exit 1
    fi
    exit 0
  fi

  # PUT /repos/.../environments/... → log and succeed (idempotent)
  if [ "$method" = "PUT" ] && printf '%s' "$path" | grep -q '/environments/'; then
    exit 0
  fi

  exit 0
fi

# ── gh secret set ────────────────────────────────────────────────────────────
if [ "${1:-}" = "secret" ] && [ "${2:-}" = "set" ]; then
  # Reject unknown flags the same way real gh does — this catches --body-file
  # which does not exist in all gh versions and would silently fail otherwise.
  i=3
  args=("$@")
  while [ $i -lt ${#args[@]} ]; do
    arg="${args[$i]}"
    case "$arg" in
      --repo|-R|--env|-e|--app|-a|--no-store|--org|-o)
        # known flags — skip their value arg
        i=$((i+1))
        ;;
      --body|-b)
        # known flag — skip value arg
        i=$((i+1))
        ;;
      -*)
        # Unknown flag — real gh exits 1 with an error message
        printf 'unknown flag: %s\nUsage:  gh secret set <secret-name>\n' "$arg" >&2
        exit 1
        ;;
      *)
        ;;
    esac
    i=$((i+1))
  done

  # Log the invocation (key name visible; value must NOT be logged)
  # We record the key name only (it appears as arg after "set"), never the value
  # (which arrives via stdin).
  key_name="${3:-UNKNOWN_KEY}"
  echo "gh secret set $key_name --repo [redacted] [value-via-stdin]" >> "$LOG"
  # Drain stdin so the caller's pipe closes cleanly
  cat > /dev/null

  # Support simulated failure: GH_STUB_SECRET_FAIL is a space-separated list
  # of key names that should fail.
  fail_keys="${GH_STUB_SECRET_FAIL:-}"
  if [ -n "$fail_keys" ] && printf '%s' "$fail_keys" | grep -qwF "$key_name"; then
    printf 'error setting secret "%s"\n' "$key_name" >&2
    exit 1
  fi

  exit 0
fi

# ── gh label create ───────────────────────────────────────────────────────────
if [ "${1:-}" = "label" ] && [ "${2:-}" = "create" ]; then
  exit 0
fi

# ── gh repo view ─────────────────────────────────────────────────────────────
if [ "${1:-}" = "repo" ] && [ "${2:-}" = "view" ]; then
  printf '%s\n' "${GH_STUB_REPO_NAME:-testowner/testrepo}"
  exit 0
fi

echo "gh-stub: unhandled: gh $*" >&2
exit 0
