# Fixture env with a hostile secret value containing shell metacharacters.
# The bootstrap script must never interpolate or echo this value.
SWARM_GITHUB_TOKEN=xoxb-"; echo pwned
# Expansion sentinel: this string can only appear in output if the value was
# actually executed. Unlike $(whoami), it cannot collide with a repo slug,
# a path, or a username that legitimately appears elsewhere.
ANTHROPIC_API_KEY=$(echo swarm_expanded_9c41f2)
SWARM_TOKEN=`id -u`
